---
// The designers whose best state over the four hosts is one state (FR-002). There are no pages for `idea` and
// `not-planned` (contracts/site-addresses.md).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { bestState, catalogue } from '../../../components/catalogue/data';
import DesignerList from '../../../components/catalogue/DesignerList.astro';
import FacetLinks from '../../../components/catalogue/FacetLinks.astro';
import { facetStates, states } from '../../../lib/catalogue/states';
import type { StateId } from '../../../lib/catalogue/types';

export function getStaticPaths() {
	return facetStates.map((state) => ({ params: { state }, props: { state } }));
}

const { state } = Astro.props as { state: StateId };
const { designers, focusAreas } = await catalogue();
const here = designers.filter((designer) => bestState(designer.hosts) === state);
const label = states[state].label;
---

<StarlightPage
	frontmatter={{
		title: `Designers: ${label}`,
		description: `The ADP designers whose most advanced state in any IDE host is "${label}".`,
		part: 'documentation',
		section: 'designers',
	}}
>
	<p>The designers whose most advanced state, over the four IDE hosts, is “{label}”. Each card shows the state per host.</p>
	<FacetLinks focusAreas={focusAreas} current={`/adp/designers/states/${state}/`} />
	<DesignerList designers={here} />
	<p><a href="/adp/designers/">All designers</a></p>
</StarlightPage>
