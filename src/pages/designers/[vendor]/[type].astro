---
// /adp/designers/<vendor>/<type>/: one page per designer, and a page at every retired address so that it keeps
// resolving (FR-011): a redirect stub for a rename, a notice for a withdrawal.
import { catalogue, redirects } from '../../../components/catalogue/data';
import DesignerPage from '../../../components/catalogue/DesignerPage.astro';
import RetiredDesigner from '../../../components/catalogue/RetiredDesigner.astro';
import type { Designer, FocusArea, Redirect } from '../../../lib/catalogue/types';

type Props = { designer: Designer; focusAreas: FocusArea[]; redirect?: undefined } | { redirect: Redirect; target?: Designer; designer?: undefined };

export async function getStaticPaths() {
	const { designers, focusAreas } = await catalogue();
	const params = (origin: string) => {
		const [vendor, type] = origin.split('/');
		return { vendor, type };
	};
	return [
		...designers.map((designer) => ({ params: params(designer.origin), props: { designer, focusAreas } })),
		...(await redirects()).map((redirect) => ({
			params: params(redirect.from),
			props: { redirect, target: designers.find((designer) => designer.origin === redirect.to) },
		})),
	];
}

const props = Astro.props as Props;
---

{props.redirect ? <RetiredDesigner redirect={props.redirect} target={props.target} /> : <DesignerPage designer={props.designer} focusAreas={props.focusAreas} />}
