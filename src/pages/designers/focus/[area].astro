---
// The designers of one focus area (FR-002, contracts/site-addresses.md).
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { catalogue } from '../../../components/catalogue/data';
import DesignerList from '../../../components/catalogue/DesignerList.astro';
import FacetLinks from '../../../components/catalogue/FacetLinks.astro';
import type { FocusArea } from '../../../lib/catalogue/types';

export async function getStaticPaths() {
	const { focusAreas } = await catalogue();
	return focusAreas.map((area) => ({ params: { area: area.slug }, props: { area } }));
}

const { area } = Astro.props as { area: FocusArea };
const { designers, focusAreas } = await catalogue();
const here = designers.filter((designer) => designer.focusAreas.includes(area.slug));
---

<StarlightPage
	frontmatter={{
		title: `Designers: ${area.name}`,
		description: `The ADP designers for ${area.name.toLowerCase()}, with their state in each IDE host.`,
		part: 'documentation',
		section: 'designers',
	}}
>
	{area.problem && <p>{area.problem}</p>}
	<FacetLinks focusAreas={focusAreas} current={`/adp/designers/focus/${area.slug}/`} />
	<DesignerList designers={here} />
	<p><a href="/adp/designers/">All designers</a></p>
</StarlightPage>
