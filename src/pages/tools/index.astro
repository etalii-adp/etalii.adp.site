---
// The catalogue overview (FR-001, FR-002, FR-014, contracts/site-addresses.md): every tool grouped by focus
// area, then "Other tools", then the ideas list. Complete without scripting; with scripting, CatalogueFilter
// filters the list in place and swaps the introduction ([data-adp-filter-intro]) for a single ticked option.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import CatalogueFilter from '../../components/catalogue/CatalogueFilter.astro';
import { catalogue } from '../../components/catalogue/data';
import ToolList from '../../components/catalogue/ToolList.astro';
import IdeasList from '../../components/catalogue/IdeasList.astro';
import SourceList from '../../components/catalogue/SourceList.astro';

const { tools, ideas, focusAreas, sources } = await catalogue();
const groups = focusAreas.map((area) => ({ id: `focus-${area.slug}`, focus: area.slug, name: area.name, tools: tools.filter((tool) => tool.focusAreas.includes(area.slug)) }));
const known = new Set(focusAreas.map((area) => area.slug));
const others = tools.filter((tool) => !tool.focusAreas.some((slug) => known.has(slug)));
if (others.length > 0) groups.push({ id: 'other-tools', focus: '', name: 'Other tools', tools: others });
---

<StarlightPage
	frontmatter={{
		title: 'Tools',
		description: 'Every ADP tool, grouped by focus area, with its purpose and its state in each host, followed by the ideas for new ones.',
		part: 'documentation',
		section: 'tools',
	}}
>
	<CatalogueFilter focusAreas={focusAreas} />

	<p data-adp-filter-intro>
		Each ADP tool is made for one task where a specialized view beats a generic diagram or plain text. This catalogue lists all {tools.length}
		{tools.length === 1 ? ' tool' : ' tools'}, grouped by the focus area they serve, with their state in each of the five hosts. A tool
		that serves several focus areas is listed under each. The states are read from the hosts' own repositories, or from ADP's list of tools for a host that keeps none; nothing is shown as available unless you can
		install it. Tick focus areas, hosts or states in the filter above to narrow the list, and follow a tool’s name to its own page.
	</p>

	{
		groups.map((group) => (
			<section class="adp-catalogue-group" aria-labelledby={group.id} data-focus={group.focus}>
				<h2 id={group.id}>{group.name}</h2>
				<ToolList tools={group.tools} />
			</section>
		))
	}

	<IdeasList ideas={ideas} focusAreas={focusAreas} />

	<SourceList sources={sources} compact />
</StarlightPage>

<style is:global>
	/* The overview uses the width of a wide screen for more columns of cards (spec 003 FR-001, amended 2026-09-28). */
	:root:has(.adp-filter) {
		--sl-content-width: 100rem;
	}
	/* Running text keeps a readable line length on the wider page. */
	:root:has(.adp-filter) .sl-markdown-content > p {
		max-width: 48rem;
	}
</style>
