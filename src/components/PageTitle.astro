---
// Replaces Starlight's PageTitle: breadcrumbs (part › section › page) above the <h1> on every page
// that belongs to a section (US2 AS3, contracts/site-navigation.md item 4).
import { partOf, sectionById } from '../data/sections';

const { data } = Astro.locals.starlightRoute.entry;
const section = sectionById(data.section);
const here = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;

// Levels that share an address (a section's start page is its part's start page, or the page itself) appear once.
const trail: { label: string; href: string }[] = [];
if (section) {
	for (const level of [partOf(section.part), section, { label: data.title, href: here }]) {
		if (!trail.some((crumb) => crumb.href === level.href)) trail.push({ label: level.label, href: level.href });
	}
}
---

{
	trail.length > 0 && (
		<nav aria-label="Breadcrumb" class="adp-breadcrumbs">
			<ol>
				{trail.map((crumb, index) =>
					index === trail.length - 1 ? (
						<li>
							<span aria-current="page">{crumb.label}</span>
						</li>
					) : (
						<li>
							<a href={crumb.href}>{crumb.label}</a>
						</li>
					)
				)}
			</ol>
		</nav>
	)
}
<h1 id="_top">{data.title}</h1>

<style>
	.adp-breadcrumbs ol {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
	}
	.adp-breadcrumbs li + li::before {
		content: '›';
		margin-inline-end: 0.5rem;
	}
	.adp-breadcrumbs a {
		color: var(--sl-color-text-accent);
	}
	h1 {
		margin-top: 1rem;
		font-size: var(--sl-text-h1);
		line-height: var(--sl-line-height-headings);
		font-weight: 600;
		color: var(--sl-color-white);
	}
</style>
