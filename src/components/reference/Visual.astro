---
// A diagram shown as a picture that reads without scripting, in light and dark, with alt text from its
// accTitle and accDescr, and its caption (FR-018, research D10).
import { mermaidPicture } from '../../lib/reference/mermaid';
import type { Visual } from '../../lib/reference/types';

interface Props {
	visual: Visual;
}

const { visual } = Astro.props;
const picture = await mermaidPicture(visual.mermaid, `${visual.title}. ${visual.description}`);
// The caption marks file names and revisions with backticks, as Markdown code.
const captionParts = visual.caption.split('`').map((text, i) => ({ text, code: i % 2 === 1 }));
---

<figure class="ref-visual not-content" data-kind={visual.kind}>
	<div class="ref-visual-picture"><Fragment set:html={picture} /></div>
	<figcaption>
		{captionParts.map((part) => (part.code ? <code>{part.text}</code> : part.text))}
	</figcaption>
</figure>
