---
// The ideas (FR-014, amended 2026-09-28): candidates that no host has planned yet, as cards like the designers', but
// apart from the catalogue, with no thumbnails, no states and no designer pages. A dashed border sets them apart.
import type { Idea } from '../../lib/catalogue/types';

interface Props {
	ideas: Idea[];
}

const { ideas } = Astro.props;
---

<section class="adp-ideas" aria-labelledby="ideas">
	<h2 id="ideas">Ideas</h2>
	<p>These are candidates for a designer. No host is building them yet, and each may or may not become one.</p>
	{
		ideas.length > 0 ? (
			<ul class="adp-idea-cards not-content">
				{ideas.map((idea) => (
					<li class="adp-idea" data-origin={idea.origin}>
						<hgroup>
							<h3>{idea.name}</h3>
							<p class="adp-origin adp-note">{idea.origin}</p>
						</hgroup>
						{idea.purpose && <p>{idea.purpose}</p>}
						<p class="adp-note">Family: {idea.family}</p>
						{idea.theory.length > 0 && (
							<>
								<h4>Sources</h4>
								<ul class="adp-idea-theory">
									{idea.theory.map((link) => (
										<li>
											<a href={link.url}>{link.title}</a>
										</li>
									))}
								</ul>
							</>
						)}
					</li>
				))}
			</ul>
		) : (
			<p class="adp-note">No ideas are listed yet.</p>
		)
	}
</section>

<style>
	.adp-idea-cards {
		display: grid;
		/* The designer cards' grid (DesignerList.astro): as many columns of at least 17rem as the width allows. */
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 17rem), 1fr));
		gap: 1rem;
		margin: 1rem 0 0;
		padding: 0;
		list-style: none;
	}
	.adp-idea {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		min-width: 0;
		padding: 1.25rem;
		border: 1px dashed var(--sl-color-gray-4);
		border-radius: 0.75rem;
	}
	h3 {
		margin: 0;
		font-size: var(--sl-text-h4);
		line-height: var(--sl-line-height-headings);
		color: var(--sl-color-white);
	}
	p {
		margin: 0;
	}
	hgroup {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
	}
	.adp-origin {
		overflow-wrap: anywhere;
	}
	h4 {
		margin: 0.25rem 0 0;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-white);
	}
	/* One link per line, without bullets. */
	.adp-idea-theory {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--sl-text-sm);
	}
	.adp-idea-theory li {
		margin: 0;
		overflow-wrap: anywhere;
	}
</style>
