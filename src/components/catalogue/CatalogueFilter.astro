---
// The overview's filter (FR-002 as amended 2026-09-28, research D6): one checkbox per kind, focus area, host and state
// (the kind facet: etalii.adp spec 002).
// This is the only client script in the catalogue. It hides the cards that do not match (OR within a facet, AND across
// facets) and keeps the ticked options in the address (?kind=…&focus=…&hosts=…&state=…), so a filtered view can be linked.
// When exactly one option is ticked, the overview's introduction ([data-adp-filter-intro]) shows that option's
// description, and the breadcrumbs and document title gain the option's name; otherwise both are as built.
// Without scripting the form stays hidden and the full list shows.
import { catalogueHosts } from '../../lib/catalogue/hosts';
import { facetStates, states } from '../../lib/catalogue/states';
import type { FocusArea } from '../../lib/catalogue/types';

interface Props {
	focusAreas: FocusArea[];
}

const { focusAreas } = Astro.props;
const eachCard = 'Each card shows the tool’s state in every host.';
const kinds = [
	{ value: 'diagram', label: 'Diagram', description: 'Tools of the diagram kind: a visual arrangement of elements and the relations between them.' },
	{ value: 'designer', label: 'Designer', description: 'Tools of the designer kind: a form-based visual layout in which nothing is connected.' },
	{ value: 'editor', label: 'Editor', description: 'Tools of the editor kind: a way of working in which typing text is the core interaction.' },
];
const facets = [
	{ key: 'kind', legend: 'Kind', options: kinds },
	{
		key: 'hosts',
		legend: 'Host',
		options: catalogueHosts.map((host) => ({ value: host.id, label: host.name, description: `The tools that ${host.name} has, or plans to have. ${eachCard}` })),
	},
	{
		key: 'focus',
		legend: 'Focus area',
		options: focusAreas.map((area) => ({ value: area.slug, label: area.name, description: area.problem || `The tools for ${area.name.toLowerCase()}.` })),
	},
	{
		key: 'state',
		legend: 'State',
		options: (['idea', ...facetStates] as const).map((state) => ({
			value: state,
			label: states[state].label,
			description:
				state === 'idea'
					? 'The ideas: candidates for a tool that no host is building yet. Each may or may not become one.'
					: `The tools whose most advanced state, over the five hosts, is “${states[state].label}”. ${eachCard}`,
		})),
	},
];
---

<form class="adp-filter not-content" aria-label="Filter tools" data-adp-filter hidden>
	{
		facets.map((facet) => (
			<fieldset class={`adp-filter-${facet.key}`}>
				<legend>{facet.legend}</legend>
				{facet.options.map((option) => (
					<label class="adp-filter-option">
						<input type="checkbox" name={facet.key} value={option.value} data-label={option.label} data-description={option.description} />
						<span>{option.label}</span>
					</label>
				))}
			</fieldset>
		))
	}
	<p class="adp-filter-status" aria-live="polite"></p>
</form>

<script>
	type Key = 'kind' | 'focus' | 'hosts' | 'state';

	for (const form of document.querySelectorAll<HTMLFormElement>('[data-adp-filter]')) {
		form.hidden = false;
		form.addEventListener('submit', (event) => event.preventDefault());
		const status = form.querySelector<HTMLElement>('.adp-filter-status')!;
		const inputs = [...form.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')];
		const keys = [...new Set(inputs.map((input) => input.name as Key))];

		// What the page was built with, restored whenever not exactly one option is ticked.
		const intro = document.querySelector<HTMLElement>('[data-adp-filter-intro]');
		const introText = intro?.textContent ?? '';
		const crumbs = document.querySelector<HTMLOListElement>('nav.adp-breadcrumbs ol');
		const crumbsHtml = crumbs?.innerHTML ?? '';
		const title = document.title;
		const here = location.pathname;

		// Tools and ideas are filtered alike (amended 2026-09-28); an idea has no host, and its state is "idea".
		const cards = [...document.querySelectorAll<HTMLElement>('.adp-tool')];
		const ideaCards = [...document.querySelectorAll<HTMLElement>('.adp-idea')];
		const ideasSection = document.querySelector<HTMLElement>('.adp-ideas');
		const count = (n: number, noun: string) => `${n} ${noun}${n === 1 ? '' : 's'}`;
		const values = (card: HTMLElement, key: Key): string[] => {
			if (key === 'hosts') return (card.dataset.hosts ?? '').split(' ').filter(Boolean).map((pair) => pair.split(':')[0]);
			return ((key === 'kind' ? card.dataset.kind : key === 'focus' ? card.dataset.focus : card.dataset.state) ?? '').split(' ').filter(Boolean);
		};

		const describe = (single: HTMLInputElement | undefined) => {
			if (intro) intro.textContent = single ? single.dataset.description! : introText;
			document.title = single ? title.replace(/^Tools/, `Tools: ${single.dataset.label}`) : title;
			if (!crumbs) return;
			crumbs.innerHTML = crumbsHtml;
			if (!single) return;
			// Documentation › Tools › <option>: the current page becomes a link, the option the current crumb.
			// New elements are shallow clones of the built ones, so they keep the breadcrumbs' scoped styles.
			const last = crumbs.querySelector<HTMLElement>('[aria-current="page"]');
			const sample = crumbs.querySelector('a');
			if (last && sample) {
				const link = sample.cloneNode(false) as HTMLAnchorElement;
				link.href = here;
				link.textContent = last.textContent;
				const current = last.cloneNode(false) as HTMLElement;
				current.textContent = single.dataset.label!;
				const item = last.parentElement!.cloneNode(false) as HTMLElement;
				item.append(current);
				last.replaceWith(link);
				crumbs.append(item);
			}
		};

		const update = () => {
			const chosen = keys.map((key) => ({ key, values: inputs.filter((input) => input.name === key && input.checked).map((input) => input.value) }));
			const matches = (card: HTMLElement) => chosen.every(({ key, values: wanted }) => wanted.length === 0 || values(card, key).some((value) => wanted.includes(value)));
			const shown = new Set<string>();
			for (const card of cards) {
				const match = matches(card);
				card.hidden = !match;
				if (match) shown.add(card.dataset.origin!);
			}
			let ideasShown = 0;
			for (const card of ideaCards) {
				const match = matches(card);
				card.hidden = !match;
				if (match) ideasShown++;
			}
			// While any option is ticked, a group without a matching tool goes, including one with no tools yet.
			// While focus areas are ticked, the other focus areas' groups and "Other tools" go too, even where a tool that
			// serves several areas would still match in them (Peter, 2026-10-05).
			const ticked = inputs.filter((input) => input.checked);
			const focus = chosen.find(({ key }) => key === 'focus')?.values ?? [];
			for (const group of document.querySelectorAll<HTMLElement>('.adp-catalogue-group')) {
				const otherArea = focus.length > 0 && !focus.includes(group.dataset.focus ?? '');
				group.hidden = otherArea || (ticked.length > 0 && group.querySelector('.adp-tool:not([hidden])') === null);
			}
			if (ideasSection) ideasSection.hidden = ticked.length > 0 && ideasShown === 0;
			// "N tools and M ideas" (amended 2026-09-28), both as filtered.
			status.textContent = `${count(shown.size, 'tool')} and ${count(ideasShown, 'idea')}`;
			describe(ticked.length === 1 ? ticked[0] : undefined);

			const query = new URLSearchParams();
			// The address keeps one order of facets, whatever order the groups are laid out in.
			const order: Key[] = ['kind', 'focus', 'hosts', 'state'];
			for (const key of order) for (const input of ticked.filter((input) => input.name === key)) query.append(input.name, input.value);
			const search = query.toString() ? `?${query}` : '';
			if (search !== location.search) history.replaceState(null, '', `${here}${search}${location.hash}`);
		};

		// A linked filter: /adp/tools/?focus=technology-assessment ticks that option.
		const requested = new URLSearchParams(location.search);
		for (const input of inputs) input.checked = requested.getAll(input.name).includes(input.value);
		form.addEventListener('change', update);
		update();
	}
</script>

<style>
	.adp-filter {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.75rem;
		margin-block: 0 1.5rem;
	}
	.adp-filter[hidden] {
		display: none;
	}
	/* Wide: Kind above Host in the first column, which together are as tall as Focus area and State beside them;
	   the rows share out the height, so both short groups stretch (Peter, 2026-09-30). */
	@media (min-width: 50rem) {
		.adp-filter {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.adp-filter-kind {
			grid-area: 1 / 1;
		}
		.adp-filter-hosts {
			grid-area: 2 / 1;
		}
		.adp-filter-focus {
			grid-area: 1 / 2 / span 2;
		}
		.adp-filter-state {
			grid-area: 1 / 3 / span 2;
		}
	}
	fieldset {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin: 0;
		padding: 0.75rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		font-size: var(--sl-text-sm);
	}
	legend {
		padding-inline: 0.25rem;
		font-weight: 600;
	}
	.adp-filter-option {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		cursor: pointer;
	}
	.adp-filter-status {
		grid-column: 1 / -1;
		margin: 0;
		font-weight: 600;
	}
</style>
