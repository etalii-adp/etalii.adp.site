---
// One designer on the overview (FR-001): name, origin tag right below it, purpose, the four host states as
// text; no screenshot, which is on the designer page (amended 2026-09-28). The data-* attributes feed CatalogueFilter.
import { catalogueHosts } from '../../lib/catalogue/hosts';
import { states } from '../../lib/catalogue/states';
import type { Designer } from '../../lib/catalogue/types';
import { bestState, designerHref, isUsable } from './data';
import StateLabel from './StateLabel.astro';

interface Props {
	designer: Designer;
}

const { designer } = Astro.props;
const best = bestState(designer.hosts);
const usable = isUsable(best);
const hostsWithState = catalogueHosts
	.filter(({ id }) => states[designer.hosts[id].state].rank >= states.planned.rank)
	.map(({ id }) => `${id}:${designer.hosts[id].state}`);
---

<li class="adp-designer" data-origin={designer.origin} data-focus={designer.focusAreas.join(' ')} data-hosts={hostsWithState.join(' ')} data-state={best}>
	<hgroup>
		<h3><a href={designerHref(designer.origin)}>{designer.name}</a></h3>
		<p class="adp-origin adp-note">{designer.origin}</p>
	</hgroup>
	<p>{designer.purpose}</p>
	{!usable && <p class="adp-note">Not yet usable</p>}
	<dl class="adp-designer-hosts">
		{
			catalogueHosts.map((host) => (
				<div>
					<dt>{host.name}</dt>
					<dd>
						<StateLabel state={designer.hosts[host.id].state} />
					</dd>
				</div>
			))
		}
	</dl>
</li>

<style>
	.adp-designer {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		min-width: 0;
		padding: 1.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
		background: var(--sl-color-gray-6);
	}
	.adp-designer[hidden] {
		display: none;
	}
	h3 {
		margin: 0;
		font-size: var(--sl-text-h4);
		line-height: var(--sl-line-height-headings);
	}
	p {
		margin: 0;
	}
	/* The origin tag is the name's subheading, in the style of "Not yet usable", right under it. */
	hgroup {
		display: flex;
		flex-direction: column;
		gap: 0.125rem;
	}
	.adp-origin {
		overflow-wrap: anywhere;
	}
	.adp-designer-hosts {
		display: grid;
		grid-template-columns: 1fr;
		gap: 0.25rem;
		/* Pushed to the card's bottom: cards in a grid row share their height, so the host blocks line up. */
		margin: auto 0 0;
		padding-block-start: 0.25rem;
		font-size: var(--sl-text-sm);
	}
	.adp-designer-hosts div {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.25rem 0.5rem;
	}
	.adp-designer-hosts dt {
		font-weight: 400;
	}
	.adp-designer-hosts dd {
		margin: 0;
	}
</style>
