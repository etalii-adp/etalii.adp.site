---
// One page per tool (FR-003 to FR-009, FR-012, FR-015), in the order of contracts/site-addresses.md § A tool
// page. Every git source is named in an adp:source meta for spec 004's source-record check.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import AvailabilityTable from './AvailabilityTable.astro';
import { bestState, filterHref, isUsable, showsScreenshots } from './data';
import ScreenshotFigure from './ScreenshotFigure.astro';
import SourceList from './SourceList.astro';
import TableScroll from './TableScroll.astro';
import type { Tool, FocusArea } from '../../lib/catalogue/types';

interface Props {
	tool: Tool;
	focusAreas: FocusArea[];
}

const { tool, focusAreas } = Astro.props;
const usable = isUsable(bestState(tool.hosts));
const withScreenshots = showsScreenshots(bestState(tool.hosts));
const screenshots = tool.screenshots.filter((screenshot) => screenshot.publishable);
const areas = tool.focusAreas.map((slug) => focusAreas.find((area) => area.slug === slug)).filter((area) => area !== undefined);
const kinds = { diagram: 'Diagram', designer: 'Designer', editor: 'Editor' } as const;
const notDescribed = 'Not described yet.';
const head = [
	...tool.sources
		.filter((record) => record.kind === 'git')
		.map((record) => ({ tag: 'meta' as const, attrs: { name: 'adp:source', content: `${record.repository}@${record.revision}:${record.path}` } })),
	{ tag: 'meta' as const, attrs: { name: 'adp:sourced', content: 'true' } },
];
// "On this page" lists every heading the page shows (amended 2026-09-28); StarlightPage cannot see them itself.
const headings = [
	{ depth: 2, slug: 'availability-heading', text: 'Availability' },
	{ depth: 2, slug: 'what-it-is-for', text: 'What it is for' },
	{ depth: 3, slug: 'the-task', text: 'The task' },
	{ depth: 3, slug: 'why-specialized', text: 'Why a specialized view helps' },
	{ depth: 3, slug: 'file-formats', text: 'File formats' },
	...(withScreenshots ? [{ depth: 2, slug: 'screenshots', text: 'Screenshots' }] : []),
	{ depth: 2, slug: 'background', text: 'Background' },
	{ depth: 2, slug: 'focus-areas', text: 'Focus areas' },
	{ depth: 2, slug: 'sources', text: 'Sources' },
];
---

<StarlightPage frontmatter={{ title: tool.name, description: tool.purpose, part: 'documentation', section: 'tools', head }} headings={headings}>
	<p class="adp-lede">{tool.purpose}</p>
	<p>
		{kinds[tool.kind]} · origin tag <code>{tool.origin}</code> · {tool.family}
	</p>

	<section id="availability" aria-labelledby="availability-heading">
		<h2 id="availability-heading">Availability</h2>
		<AvailabilityTable tool={tool} />
	</section>

	<section aria-labelledby="what-it-is-for">
		<h2 id="what-it-is-for">What it is for</h2>
		<h3 id="the-task">The task</h3>
		<p>{tool.task ?? notDescribed}</p>
		<h3 id="why-specialized">Why a specialized view helps</h3>
		<p>{tool.whySpecialized ?? notDescribed}</p>
		<h3 id="file-formats">File formats</h3>
		{
			tool.fileFormats.length > 0 ? (
				<TableScroll label="File formats">
					<table>
						<thead>
							<tr>
								<th scope="col">Extension</th>
								<th scope="col">Format</th>
								<th scope="col">Reads</th>
								<th scope="col">Writes</th>
							</tr>
						</thead>
						<tbody>
							{tool.fileFormats.map((format) => (
								<tr>
									<td>
										<code>{format.extension}</code>
									</td>
									<td>{format.name}</td>
									<td>{format.reads ? 'Yes' : 'No'}</td>
									<td>{format.writes ? 'Yes' : 'No'}</td>
								</tr>
							))}
						</tbody>
					</table>
				</TableScroll>
			) : (
				<p>{notDescribed}</p>
			)
		}
	</section>

	{
		withScreenshots && (
			<section aria-labelledby="screenshots">
				<h2 id="screenshots">Screenshots</h2>
				{screenshots.length > 0 ? (
					screenshots.map((screenshot) => <ScreenshotFigure screenshot={screenshot} inProgress={!usable} />)
				) : (
					<p class="adp-pending">Screenshot pending. A screenshot is shown once its source is licensed and described.</p>
				)}
			</section>
		)
	}

	<section aria-labelledby="background">
		<h2 id="background">Background</h2>
		{
			tool.theory.length > 0 ? (
				<ul>
					{tool.theory.map((link) => (
						<li>
							<a href={link.url}>{link.title}</a>
						</li>
					))}
				</ul>
			) : (
				<p>No background links yet.</p>
			)
		}
		{
			tool.definition && (
				<p>
					Specified in DISL {tool.definition.dislVersion}: <a href={tool.definition.url}>the tool's specification</a>. See the{' '}
					<a href="/adp/disl/">DISL reference</a>.
				</p>
			)
		}
	</section>

	<section aria-labelledby="focus-areas">
		<h2 id="focus-areas">Focus areas</h2>
		{
			areas.length > 0 ? (
				<ul>
					{areas.map((area) => (
						<li>
							<a href={filterHref('focus', area.slug)}>{area.name}</a>
						</li>
					))}
				</ul>
			) : (
				<p>Not in a focus area yet.</p>
			)
		}
	</section>

	<section aria-labelledby="sources">
		<h2 id="sources">Sources</h2>
		<SourceList sources={tool.sources} />
	</section>
</StarlightPage>

<style>
	.adp-lede {
		font-size: var(--sl-text-lg);
	}
	code {
		overflow-wrap: anywhere;
	}
</style>
