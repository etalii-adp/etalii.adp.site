---
// Filtering without scripting (FR-002, research D6): plain links to one page per focus area, host and state.
import { catalogueHosts } from '../../lib/catalogue/hosts';
import { facetStates, states } from '../../lib/catalogue/states';
import type { FocusArea } from '../../lib/catalogue/types';

interface Props {
	focusAreas: FocusArea[];
	/** The address of the current facet page, marked with aria-current. */
	current?: string;
}

const { focusAreas, current } = Astro.props;
const facets = [
	{ label: 'By focus area', links: focusAreas.map((area) => ({ href: `/adp/designers/focus/${area.slug}/`, label: area.name })) },
	{ label: 'By host', links: catalogueHosts.map((host) => ({ href: `/adp/designers/hosts/${host.id}/`, label: host.name })) },
	{ label: 'By state', links: facetStates.map((state) => ({ href: `/adp/designers/states/${state}/`, label: states[state].label })) },
];
---

<div class="adp-facets">
	{
		facets.map((facet) => (
			<nav aria-label={`Designers ${facet.label.toLowerCase()}`}>
				<h2 class="adp-facet-title">{facet.label}</h2>
				<ul>
					{facet.links.map((link) => (
						<li>
							<a href={link.href} aria-current={link.href === current ? 'page' : undefined}>
								{link.label}
							</a>
						</li>
					))}
				</ul>
			</nav>
		))
	}
</div>

<style>
	.adp-facets {
		display: grid;
		grid-template-columns: 1fr;
		gap: 1rem;
		margin-block: 1.5rem;
		padding: 1rem 1.25rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.75rem;
	}
	@media (min-width: 50rem) {
		.adp-facets {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}
	.adp-facet-title {
		margin: 0 0 0.5rem;
		font-size: var(--sl-text-base);
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
		margin: 0;
		padding: 0;
		list-style: none;
		font-size: var(--sl-text-sm);
	}
	li {
		margin: 0;
	}
	[aria-current='page'] {
		font-weight: 700;
		text-decoration: none;
		color: var(--sl-color-white);
	}
</style>
