---
// The hosts on the home page: the four IDE hosts and Notion (FR-006, US1 AS3), each with a decorative illustration. The state is text, never colour alone (WCAG 1.4.1);
// a host links only to something public, otherwise it says so (constitution principle III).
// Each heading links to the tools overview filtered on that host, as the focus areas' headings do (Peter, 2026-10-08).
import { getCollection } from 'astro:content';
import { hostIds, inOrder } from '../data/order';
import { filterHref } from './catalogue/data';

const hosts = inOrder(await getCollection('hosts'), hostIds);
const stateLabels = { available: 'Available', 'in-progress': 'In progress', planned: 'Planned' } as const;
const latest = new Date(Math.max(...hosts.map(({ data }) => data.source.taken.getTime())));
const takenOn = latest.toISOString().slice(0, 10);
---

<ul class="adp-cards adp-hosts not-content">
	{
		hosts.map(({ data }) => (
			<li class="adp-card">
				<img src={data.illustration.src} alt="" width="160" height="120" loading="lazy" decoding="async" />
				<h3>
					<a href={filterHref('hosts', data.id)}>{data.name}</a>
				</h3>
				<p class="adp-state" data-state={data.state}>{stateLabels[data.state]}</p>
				<p>{data.summary}</p>
				{data.link ? <a href={data.link}>{data.linkLabel}</a> : <p class="adp-note">{data.unavailableNote}</p>}
			</li>
		))
	}
</ul>
<p class="adp-source">
	Host states from the host repositories, taken on <time datetime={takenOn}>{takenOn}</time>.
</p>
