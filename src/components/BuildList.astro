---
// The build of each repository (the organisation profile's badge table, without the badges: a badge is an
// image from another origin). A private repository is named but not linked (constitution principle III).
import { builds, organisation } from '../data/builds';
---

<table class="adp-builds not-content">
	<caption>Build workflow of each repository</caption>
	<thead>
		<tr>
			<th scope="col">Repository</th>
			<th scope="col">Build</th>
		</tr>
	</thead>
	<tbody>
		{
			builds.map((build) => (
				<tr>
					<th scope="row">
						{build.public ? <a href={`${organisation}/${build.repository}`}>{build.repository}</a> : build.repository}
					</th>
					<td>
						{!build.workflow
							? 'N/A'
							: build.public
								? <a href={`${organisation}/${build.repository}/actions/workflows/${build.workflow}`}>{build.workflow}</a>
								: `${build.workflow} (not public yet)`}
					</td>
				</tr>
			))
		}
	</tbody>
</table>
<p class="adp-source">
	The live build status of each repository is shown on the <a href={organisation}>organisation page</a>.
</p>

<style>
	.adp-builds {
		margin-block-start: 1.5rem;
		border-collapse: collapse;
		width: 100%;
	}
	caption {
		text-align: start;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		padding-block-end: 0.5rem;
	}
	th,
	td {
		padding: 0.5rem 0.75rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
		text-align: start;
		overflow-wrap: anywhere;
	}
	tbody th {
		font-weight: 400;
	}
</style>
