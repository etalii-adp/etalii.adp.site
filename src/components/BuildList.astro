---
// The build and statistics of each repository, as in the organisation profile's badge table. The status badges
// (github.com) and the statistics badges (img.shields.io) are the only resources this site loads from another
// origin (spec 001 FR-015). A private repository is named but not linked, and shows no badge, because GitHub
// serves neither to visitors (constitution principle III).
import { badgeOrigin, builds, followersBadge, organisation, repositoryStats, statsOrigin } from '../data/builds';
---

<p class="adp-followers">
	<a href={`${organisation}`}>
		<img src={`${statsOrigin}${followersBadge}`} alt="Followers of the etalii-adp organisation" height="20" referrerpolicy="no-referrer" />
	</a>
</p>

<div class="adp-builds-scroll not-content" role="region" aria-label="Build status and statistics of each repository" tabindex="0">
<table class="adp-builds">
	<caption>Build status and statistics of each repository</caption>
	<thead>
		<tr>
			<th scope="col">Repository</th>
			<th scope="col">Build</th>
			{repositoryStats.map((stat) => <th scope="col">{stat.label}</th>)}
		</tr>
	</thead>
	<tbody>
		{
			builds.map((build) => (
				<tr>
					<th scope="row">
						{build.public ? <a href={`${organisation}/${build.repository}`}>{build.repository}</a> : build.repository}
					</th>
					<td>
						{!build.workflow
							? 'N/A'
							: build.public
								? (
										<a href={`${organisation}/${build.repository}/actions/workflows/${build.workflow}?query=branch%3Adevelop`}>
											<img
												src={`${badgeOrigin}/etalii-adp/${build.repository}/actions/workflows/${build.workflow}/badge.svg?branch=develop`}
												alt={`${build.workflow} status of ${build.repository}`}
												height="20"
												referrerpolicy="no-referrer"
											/>
										</a>
									)
								: `${build.workflow} (not public yet)`}
					</td>
					{repositoryStats.map((stat) => (
						<td>
							{build.public ? (
								<a href={stat.link(build.repository)}>
									<img
										src={`${statsOrigin}${stat.path(build.repository)}`}
										alt={`${stat.label} of ${build.repository}`}
										height="20"
										referrerpolicy="no-referrer"
									/>
								</a>
							) : (
								'N/A'
							)}
						</td>
					))}
				</tr>
			))
		}
	</tbody>
</table>
</div>

<style>
	.adp-followers {
		margin-block-start: 1.5rem;
	}
	/* Five columns of badges are wider than a phone: the table scrolls on its own rather than the page. */
	.adp-builds-scroll {
		margin-block-start: 1rem;
		overflow-x: auto;
	}
	.adp-builds {
		border-collapse: collapse;
		width: 100%;
	}
	caption {
		text-align: start;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		padding-block-end: 0.5rem;
	}
	th,
	td {
		padding: 0.5rem 0.75rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
		text-align: start;
		overflow-wrap: anywhere;
	}
	img {
		display: block;
	}
	tbody th {
		font-weight: 400;
	}
</style>
