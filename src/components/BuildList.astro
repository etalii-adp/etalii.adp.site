---
// The build of each repository, as in the organisation profile's badge table. The status badges are the one
// resource this site loads from another origin (spec 001 FR-015). A private repository is named but not linked,
// and shows no badge, because GitHub serves neither to visitors (constitution principle III).
import { badgeOrigin, builds, organisation } from '../data/builds';
---

<table class="adp-builds not-content">
	<caption>Build status of each repository</caption>
	<thead>
		<tr>
			<th scope="col">Repository</th>
			<th scope="col">Build</th>
		</tr>
	</thead>
	<tbody>
		{
			builds.map((build) => (
				<tr>
					<th scope="row">
						{build.public ? <a href={`${organisation}/${build.repository}`}>{build.repository}</a> : build.repository}
					</th>
					<td>
						{!build.workflow
							? 'N/A'
							: build.public
								? (
										<a href={`${organisation}/${build.repository}/actions/workflows/${build.workflow}?query=branch%3Adevelop`}>
											<img
												src={`${badgeOrigin}/etalii-adp/${build.repository}/actions/workflows/${build.workflow}/badge.svg?branch=develop`}
												alt={`${build.workflow} status of ${build.repository}`}
												height="20"
												referrerpolicy="no-referrer"
											/>
										</a>
									)
								: `${build.workflow} (not public yet)`}
					</td>
				</tr>
			))
		}
	</tbody>
</table>

<style>
	.adp-builds {
		margin-block-start: 1.5rem;
		border-collapse: collapse;
		width: 100%;
	}
	caption {
		text-align: start;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-3);
		padding-block-end: 0.5rem;
	}
	th,
	td {
		padding: 0.5rem 0.75rem;
		border-bottom: 1px solid var(--sl-color-gray-5);
		text-align: start;
		overflow-wrap: anywhere;
	}
	img {
		display: block;
	}
	tbody th {
		font-weight: 400;
	}
</style>
