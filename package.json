{
  "name": "etalii-adp-site",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run build:search && node scripts/assemble-root.mjs",
    "build:search": "tsx scripts/reference/search-index.ts",
    "build:versioning-test": "astro build --mode reference-versioning-test && npm run build:search && node scripts/assemble-root.mjs",
    "preview": "sirv dist --port 4321",
    "test": "vitest run",
    "reference:refresh": "tsx scripts/reference/refresh.ts",
    "check:reference": "tsx scripts/reference/check.ts",
    "check:moved": "tsx scripts/reference/check-moved.ts",
    "check:links": "linkinator index.html 404.html --config linkinator.config.json",
    "check:catalogue": "node scripts/catalogue/check.ts",
    "check:pages": "playwright test",
    "check": "npm run check:links && npm run check:catalogue && npm run check:pages",
    "catalogue:notion": "node scripts/catalogue/notion.ts",
    "catalogue:report": "node scripts/catalogue/report.ts",
    "catalogue:sync-notion": "node scripts/catalogue/sync-notion.ts",
    "test:catalogue": "node --test \"tests/unit/catalogue/**/*.test.ts\"",
    "refresh": "node scripts/refresh/run.mjs",
    "refresh:decide": "node scripts/refresh/decide.mjs",
    "refresh:verify": "node scripts/refresh/verify.mjs",
    "refresh:lint": "node scripts/refresh/lint.mjs",
    "test:refresh": "node --test \"scripts/refresh/**/*.test.mjs\""
  },
  "dependencies": {
    "@astrojs/starlight": "^0.42.4",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "^7.3.5",
    "github-slugger": "^2.0.0",
    "hast-util-to-html": "^9.0.5",
    "hast-util-to-string": "^3.0.1",
    "mdast-util-to-string": "^4.0.0",
    "parse5": "^8.0.1",
    "rehype-mermaid": "^3.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "linkinator": "^8.1.0",
    "pagefind": "^1.5.2",
    "playwright": "^1.63.0",
    "sirv-cli": "^3.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
