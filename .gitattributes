# Normalise text to LF in the repository; check out with the platform's native endings.
* text=auto

# Shell scripts must stay LF everywhere, or bash fails on the carriage returns.
*.sh text eol=lf

# Sourced content is kept byte for byte as its source committed it; its SHA-256 records depend on that.
sources/** -text

# Test fixtures stand in for source repositories, so they are kept byte for byte too.
scripts/refresh/fixtures/** -text
