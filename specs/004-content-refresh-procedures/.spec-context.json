  "telemetryInstanceId": "f576f38d-c716-491b-ab0f-c304240c8619",
  "approach": "Each refresh is a Markdown procedure in procedures/ whose mechanical steps are one command, npm run refresh -- <id>, backed by small Node scripts that copy source files verbatim into sources/<short>/ with a per-procedure lock of repository, commit and SHA-256. A run verifies with the site's build/check plus a source-record check, then creates or updates the pull request of its fixed refresh/<short> branch; an hourly workflow runs the same command with a GitHub App token.",
  "decisions": [
    {
      "decision": "Procedures are Markdown documents; mechanics are Node scripts behind npm run refresh",
      "why": "Deterministic copying/diffing makes first-run PRs pass checks and lets automatic runs work without an LLM in CI",
      "rejected": "Prose-only procedures executed by an agent; a Claude skill per procedure"
    },
    {
      "decision": "Commit verbatim source copies under sources/<short>/ with one source.lock.json per procedure",
      "why": "PR diffs show the actual changed text, builds are offline and reproducible, and concurrent refresh PRs never touch the same file",
      "rejected": "Git submodules; fetching at build time from pinned SHAs; one shared lock file"
    },
    {
      "decision": "Hourly scheduled poll in this repository, plus workflow_dispatch and optional repository_dispatch",
      "why": "Meets run-on-source-change without adding workflows or secrets to five other repositories",
      "rejected": "Push-based repository_dispatch from each source as the only trigger"
    },
    {
      "decision": "GitHub App installation token for automatic runs",
      "why": "Four sources are private and PRs opened with GITHUB_TOKEN do not trigger CI",
      "rejected": "GITHUB_TOKEN; fine-grained personal access token (kept as stopgap)"
    },
    {
      "decision": "Fixed branch refresh/<procedure>, rebuilt from develop and force-pushed each run",
      "why": "Makes finding and updating the open PR from an earlier run a simple lookup (FR-008)",
      "rejected": "A new dated branch per run"
    },
    {
      "decision": "Unmapped states or unlinked screenshots exit 3 with a decision file; interactive runs ask via selection, automatic runs open a Refresh blocked issue",
      "why": "These are the only questions a source cannot answer, and answers land as reviewed mapping changes",
      "rejected": "Guessing a mapping; failing without a question"
    }
  ],
  "step_summaries": {
    "plan": {
      "summary": "Five Markdown procedures backed by npm run refresh; verbatim sources/ copies with locks; hourly App-token workflow; PRs on fixed refresh/* branches; contracts for CLI, PR body, lock schema and site integration."
    }
  },
  "currentTask": "T060"
