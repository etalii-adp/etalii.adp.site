{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etalii.net/adp/site/contracts/reference-data.schema.json",
  "title": "DEDL reference: stored data",
  "description": "Shapes of src/content/reference/languages.json and src/content/reference/<language>/<version>/source.json (data-model.md).",
  "$defs": {
    "Languages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/Language" }
    },
    "Language": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "short", "repository", "branch", "path", "prose", "schema", "schemaAddress"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z]+$", "not": { "enum": ["designers", "search", "pagefind"] } },
        "name": { "type": "string", "minLength": 1 },
        "short": { "type": "string", "minLength": 1 },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$" },
        "branch": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "prose": { "type": "string", "pattern": "\\.md$" },
        "schema": { "type": "string", "pattern": "\\.json$" },
        "schemaAddress": { "type": "string", "pattern": "^/[a-z]+/schema/\\{version\\}/\\{schema\\}$" }
      }
    },
    "Version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "version", "status", "date", "source", "files", "retrieved"],
      "properties": {
        "language": { "type": "string", "pattern": "^[a-z]+$" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+(\\.\\d+)?$" },
        "status": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date" },
        "source": { "$ref": "#/$defs/SourceRecord" },
        "files": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/FileRecord" }
        },
        "retrieved": { "type": "string", "format": "date-time" }
      }
    },
    "SourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "repository", "path", "revision", "licence"],
      "properties": {
        "kind": { "const": "git" },
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$" },
        "path": { "type": "string", "minLength": 1 },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "licence": { "type": "string", "minLength": 1, "description": "SPDX identifier; a snapshot without one is refused (research D14)." },
        "copyright": { "type": ["string", "null"] }
      }
    },
    "FileRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "role", "sha256", "size"],
      "properties": {
        "name": { "type": "string", "pattern": "^[^/\\\\]+$" },
        "role": { "enum": ["prose", "schema", "definition", "document", "other"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
